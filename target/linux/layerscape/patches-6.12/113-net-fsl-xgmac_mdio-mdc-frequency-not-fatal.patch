From: RaymondBien <raymond@RaymondBiens-Mac-mini.local>
Date: Tue, 6 Oct 2026 10:00:00 +0700
Subject: [PATCH] net/fsl: xgmac_mdio: an MDC frequency that cannot be set
 does not cost the bus

With "clock-frequency" in the device tree the probe failed when the
input clock was missing or the frequency out of range, and the bus went
with it: every PHY on it, and so the port, was lost over a setting that
only makes the bus faster. Keep the frequency the bootloader left and
warn instead; only a clock that is not registered yet still defers the
probe.

Round the divider up, so MDC is never faster than what was asked for
(the old rounding gives 2.509 MHz for 2.5 MHz from a 700 MHz clock),
and log the frequency that was set next to the one it replaced.

--- a/drivers/net/ethernet/freescale/xgmac_mdio.c
+++ b/drivers/net/ethernet/freescale/xgmac_mdio.c
@@ -38,6 +38,7 @@
 
 #define MDIO_STAT_ENC		BIT(6)
 #define MDIO_STAT_CLKDIV(x)	(((x) & 0x1ff) << 7)
+#define MDIO_STAT_CLKDIV_GET(x)	(((x) >> 7) & 0x1ff)
 #define MDIO_STAT_BSY		BIT(0)
 #define MDIO_STAT_RD_ER		BIT(1)
 #define MDIO_STAT_PRE_DIS	BIT(5)
@@ -329,27 +330,38 @@
 	struct mdio_fsl_priv *priv = (struct mdio_fsl_priv *)bus->priv;
 	struct tgec_mdio_controller __iomem *regs = priv->mdio_base;
 	struct device *dev = bus->parent;
-	u32 mdio_stat, div;
+	unsigned long rate;
+	u32 mdio_stat, div, was;
 
-	if (device_property_read_u32(dev, "clock-frequency", &priv->mdc_freq))
+	if (device_property_read_u32(dev, "clock-frequency", &priv->mdc_freq) ||
+	    !priv->mdc_freq)
 		return 0;
 
 	priv->enet_clk = devm_clk_get(dev, NULL);
 	if (IS_ERR(priv->enet_clk)) {
-		dev_err(dev, "Input clock unknown, not changing MDC frequency");
-		return PTR_ERR(priv->enet_clk);
+		/* A clock that is not there yet is waited for. */
+		if (PTR_ERR(priv->enet_clk) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		dev_warn(dev, "Input clock unknown, not changing MDC frequency\n");
+		return 0;
 	}
 
-	div = ((clk_get_rate(priv->enet_clk) / priv->mdc_freq) - 1) / 2;
+	rate = clk_get_rate(priv->enet_clk);
+	/* Round the divider up: MDC must not be faster than asked for. */
+	div = DIV_ROUND_UP(rate, priv->mdc_freq) / 2;
 	if (div < 5 || div > 0x1ff) {
-		dev_err(dev, "Requested MDC frequency is out of range, ignoring");
-		return -EINVAL;
+		dev_warn(dev, "MDC frequency %u Hz is out of range for an input clock of %lu Hz, not changing it\n",
+			 priv->mdc_freq, rate);
+		return 0;
 	}
 
 	mdio_stat = xgmac_read32(&regs->mdio_stat, priv->is_little_endian);
+	was = MDIO_STAT_CLKDIV_GET(mdio_stat);
 	mdio_stat &= ~MDIO_STAT_CLKDIV(0x1ff);
 	mdio_stat |= MDIO_STAT_CLKDIV(div);
 	xgmac_write32(mdio_stat, &regs->mdio_stat, priv->is_little_endian);
+	dev_info(dev, "MDC frequency set to %lu Hz (was %lu Hz)\n",
+		 rate / (2 * div + 1), rate / (2 * was + 1));
 	return 0;
 }
 
