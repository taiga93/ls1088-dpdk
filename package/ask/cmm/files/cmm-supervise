#!/bin/sh
# procd runs this as the cmm instance command (see /etc/init.d/cmm). It
# re-applies CEETM QoS once cmm's CLI is ready, then execs cmm in the
# foreground, under the supervisor of bmcHwAccel. cmm's QoS state is in-memory
# and does not survive a restart; the re-apply happens once per start of the
# service, not after the supervisor restarted a cmm that died.
#
# The re-applier is DOUBLE-FORKED so it reparents to init (pid 1): the outer
# subshell backgrounds the loop and exits at once (reaped by this wrapper),
# orphaning the loop to init. Otherwise the loop outlives the exec below as a
# child of the cmm C-daemon -- which never wait()s for it -- and lingers as a
# <defunct> zombie for cmm's whole lifetime (one per (re)start).

if [ -x /etc/init.d/cmmqos ]; then
	( (
		# cmm writes its pidfile before its CLI socket is listening, so a live
		# process is not a readiness signal. Just retry the apply: it fails
		# cleanly (non-zero) until cmm accepts 'cmm -c qm-config', then succeeds
		# once. flock inside cmmqos serialises us against the boot-time apply.
		i=0
		while [ $i -lt 30 ]; do
			sleep 1
			/etc/init.d/cmmqos apply >/dev/null 2>&1 && exit 0
			i=$((i + 1))
		done
		logger -t cmm "cmm-supervise: QoS not applied within 30s of cmm (re)start"
	) & )
fi

# What cmm never hands to the hardware: the list of the ASK sources, then the
# list of bmcHwAccel (connections that BMC features keep on the CPU). cmm reads
# one file, and /etc/config/fastforward is a conffile that a sysupgrade keeps,
# so the two are joined at each start. The list of bmcHwAccel is in the joined
# file also when the other one cannot be read.
conf=/etc/config/fastforward
if [ -r /usr/lib/bmcHwAccel/fastforward ]; then
	mkdir -p /var/run/bmcHwAccel
	{ cat /etc/config/fastforward 2>/dev/null; cat /usr/lib/bmcHwAccel/fastforward; } \
		> /var/run/bmcHwAccel/fastforward && conf=/var/run/bmcHwAccel/fastforward
fi

# Traffic between two ports of a bridge stays on the CPU (-B, ./patches): in the
# hardware it would pass the rules that macfilter and client_control check on
# every packet. Only "bridge" 1 in the configuration of bmcHwAccel hands it to
# the hardware, for the trial of scripts/hwaccel/acceptance.sh.
bridge=-B
[ "$(uci -q get bmchwaccel.global.bridge)" != 1 ] || bridge=

# bmcHwAccel restarts a cmm that died, a few times, and cleans up after it
# (package/bmc/bmcHwAccel); procd does not respawn this instance.
# shellcheck disable=SC2086
[ ! -x /usr/lib/bmcHwAccel/supervise ] ||
	exec /usr/lib/bmcHwAccel/supervise /usr/bin/cmm -F -f "$conf" -n 131072 $bridge
# shellcheck disable=SC2086
exec /usr/bin/cmm -F -f "$conf" -n 131072 $bridge
