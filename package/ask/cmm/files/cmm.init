#!/bin/sh /etc/rc.common
# ASK Connection Manager, run by procd. cmm runs in the foreground (-F, added
# upstream) so that it can be tracked and restarted on a crash instead of
# letting the fast path silently die. This script is disabled at first boot:
# bmcHwAccel loads the modules cdx, auto_bridge and fci and then starts and
# stops this service (package/bmc/bmcHwAccel).
#
# cmmqos (START=55) programs CEETM QoS *into* the running cmm and must stay
# after us. cmm's QoS state is in-memory and is lost on a restart, so the
# instance command is the cmm-supervise wrapper, which re-applies QoS after
# cmm's CLI comes up, at the start of the service only.

USE_PROCD=1
START=54
STOP=10

vwd_fast_path() {
	[ -e /sys/class/vwd/vwd0/vwd_fast_path_enable ] && \
		echo "$1" > /sys/class/vwd/vwd0/vwd_fast_path_enable
}

start_service() {
	[ -e /dev/cdx_ctrl ] || {
		echo "cmm: /dev/cdx_ctrl not present, cdx.ko not loaded - not starting" >&2
		return 1
	}
	vwd_fast_path 1

	procd_open_instance cmm
	procd_set_param command /usr/sbin/cmm-supervise
	# No respawn by procd: the supervisor of bmcHwAccel, which cmm-supervise
	# ends in, restarts a cmm that died. It gives up on a cmm that keeps
	# dying, and procd then reports the service as not running.
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd SIGTERMs cmm; its handler exits cleanly and removes the pidfile.
	vwd_fast_path 0
}
