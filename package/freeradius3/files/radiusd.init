#!/bin/sh /etc/rc.common
#
# Copyright (C) 2006-2015 OpenWrt.org
#

USE_PROCD=1

START=50

NAME=radiusd
PROG=/usr/sbin/radiusd
DEFAULT=/etc/default/radiusd

start_service()
{
	local security_mode

	security_mode="$(uci -q get system.@system[0].security_mode 2>/dev/null)"
	case "$security_mode" in
		fido|off) return 0 ;;
		nac) ;;
		*)
			# Compatibility with images created before security_mode.
			[ "$(uci -q get bmcfido.config.enable 2>/dev/null)" = "1" ] && return 0
			;;
	esac

	[ -f $DEFAULT ] && . $DEFAULT
	mkdir -p /var/log
	mkdir -p /var/run
	mkdir -p /var/db/radacct
	mkdir -p /tmp/radiusd

	procd_open_instance
	procd_set_param command $PROG -s
	procd_set_param env LD_LIBRARY_PATH=/usr/lib/freeradius3
	[ -n "$IPADDR" ] && procd_append_param command -i $IPADDR
	[ -n "$OPTIONS" ] && procd_append_param command $OPTIONS
	procd_set_param respawn
	procd_close_instance
}
