+
+static bool global_redirect_target_match(const char *url, const char *target)
+{
+	size_t len;
+
+	if (!url || !target)
+		return false;
+
+	/* When target is "/", keep redirecting "/" too (no bypass). */
+	if (!strcmp(target, "/"))
+		return false;
+
+	len = strlen(target);
+	if (strncmp(url, target, len))
+		return false;
+
+	return url[len] == 0 || url[len] == '?';
+}
+
+static const char *redirect_status_text(int code)
+{
+	switch (code) {
+	case 301:
+		return "Moved Permanently";
+	case 302:
+		return "Found";
+	case 303:
+		return "See Other";
+	case 307:
+		return "Temporary Redirect";
+	case 308:
+		return "Permanent Redirect";
+	default:
+		return "Redirect";
+	}
 }
 
+static bool global_redirect_check(struct client *cl)
+{
+	int rem, code;
+	struct blob_attr *cur;
+	char *ptr, *host = NULL, *host_copy = NULL;
+	const char *url = NULL, *target;
+	const char *dst_host = conf.redirect_host;
+	int port;
+
+	if (!conf.redirect_mode || !conf.redirect_page)
+		return true;
+
+	blob_for_each_attr(cur, cl->hdr.head, rem) {
+		if (!strcmp(blobmsg_name(cur), "URL"))
+			url = blobmsg_get_string(cur);
+		else if (!dst_host && !strcmp(blobmsg_name(cur), "host"))
+			host = blobmsg_get_string(cur);
+
+		if (url && (dst_host || host))
+			break;
+	}
+
+	if (!url || (!dst_host && !host))
+	{
+		fprintf(stderr,
+		        "uhttpd: global redirect skip missing url/host (url=%s host=%s dst_host=%s)\n",
+		        url ? url : "(null)", host ? host : "(null)", dst_host ? dst_host : "(null)");
+		return true;
+	}
+
+	if (global_redirect_target_match(url, conf.redirect_page)) {
+		fprintf(stderr, "uhttpd: global redirect bypass target-match url=%s target=%s\n",
+		        url, conf.redirect_page);
+		return true;
+	}
+
+	if (dst_host) {
+		host_copy = alloca(strlen(dst_host) + 1);
+		strcpy(host_copy, dst_host);
+	}
+	else {
+		host_copy = alloca(strlen(host) + 1);
+		strcpy(host_copy, host);
+
+		if ((ptr = strchr(host_copy, ']')) != NULL)
+			*(ptr + 1) = 0;
+		else if ((ptr = strchr(host_copy, ':')) != NULL)
+			*ptr = 0;
+	}
+
+	code = conf.redirect_code;
+	if (code < 300 || code > 399)
+		code = 302;
+
+	port = conf.redirect_https_port;
+	if (port <= 0 || port > 65535 || port == 443)
+		port = 4443;
+
+	target = conf.redirect_page;
+
+	cl->request.disable_chunked = true;
+	cl->request.connection_close = true;
+
+	fprintf(stderr,
+	        "uhttpd: global redirect apply url=%s src_host=%s dst_host=%s location=https://%s:%d%s code=%d\n",
+	        url, host ? host : "(null)", dst_host ? dst_host : "(null)",
+	        host_copy, port, target, code);
+	uh_http_header(cl, code, redirect_status_text(code));
+	ustream_printf(cl->us, "Location: https://%s:%d%s\r\n\r\n", host_copy, port, target);
+	uh_request_done(cl);
+
+	return false;
+}
