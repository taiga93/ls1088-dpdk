config tracker 'main'
        option enabled '0'
        list interface 'br-lan'
        list http_port '80'
        list http_port '8080'
        list http_port '8000'
        list http_port '8888'
        option body_threshold_bytes '65536'
        option track_small_bodies '0'
        option max_active_flows '4096'
        option max_header_bytes '32768'
        option max_uri_bytes '2048'
        option max_filename_bytes '512'
        option flow_idle_timeout_sec '120'
        option capture_snaplen '262144'

# Add exact client IPs or CIDR ranges before enabling, for example:
#       list lan_client '192.168.1.10'
#       list lan_client 'fd00:1234::10'
