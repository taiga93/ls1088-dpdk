#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

PROG=/usr/sbin/http-file-tracker

append_arg() {
	local value="$1"
	local flag="$2"
	procd_append_param command "$flag" "$value"
}

append_arg_list() {
	local cfg="$1"
	local option="$2"
	local flag="$3"
	config_list_foreach "$cfg" "$option" append_arg "$flag"
}

start_service() {
	config_load http-file-tracker

	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"

	append_arg_list main interface --interface
	append_arg_list main http_port --http-port
	append_arg_list main lan_client --lan-client

	local body_threshold_bytes track_small_bodies max_active_flows
	local max_header_bytes max_uri_bytes max_filename_bytes
	local flow_idle_timeout_sec capture_snaplen

	config_get body_threshold_bytes main body_threshold_bytes 65536
	config_get_bool track_small_bodies main track_small_bodies 0
	config_get max_active_flows main max_active_flows 4096
	config_get max_header_bytes main max_header_bytes 32768
	config_get max_uri_bytes main max_uri_bytes 2048
	config_get max_filename_bytes main max_filename_bytes 512
	config_get flow_idle_timeout_sec main flow_idle_timeout_sec 120
	config_get capture_snaplen main capture_snaplen 262144
	case "$capture_snaplen" in
		''|*[!0-9]*) capture_snaplen=262144 ;;
		*) [ "$capture_snaplen" -lt 262144 ] && capture_snaplen=262144 ;;
	esac

	procd_append_param command --body-threshold-bytes "$body_threshold_bytes"
	[ "$track_small_bodies" -eq 1 ] && procd_append_param command --track-small-bodies
	procd_append_param command --max-active-flows "$max_active_flows"
	procd_append_param command --max-header-bytes "$max_header_bytes"
	procd_append_param command --max-uri-bytes "$max_uri_bytes"
	procd_append_param command --max-filename-bytes "$max_filename_bytes"
	procd_append_param command --flow-idle-timeout-sec "$flow_idle_timeout_sec"
	procd_append_param command --capture-snaplen "$capture_snaplen"

	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger http-file-tracker
}
