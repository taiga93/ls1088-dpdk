#!/bin/sh /etc/rc.common

USE_PROCD=1

START=99
STOP=10

EXTRA_COMMANDS="reload_rules"
EXTRA_HELP="        reload_rules  Re-apply FIDO firewall rules without restarting Node"

FIDO_CHAIN="BMC_FIDO"
FIDO_NAT_CHAIN="FIDO_REDIRECT"
IPSET_NAME="authorized_table"
SFA_IPSET_NAME="sfa_server_ports"
BRIDGE_NF_CALL_IPTABLES="/proc/sys/net/bridge/bridge-nf-call-iptables"

is_fido_mode_enabled() {
    local security_mode
    local enable

    security_mode="$(uci -q get system.@system[0].security_mode 2>/dev/null)"
    case "$security_mode" in
        fido) return 0 ;;
        nac|off) return 1 ;;
    esac

    # Compatibility with configurations created before security_mode.
    config_load bmcfido
    config_get_bool enable config enable 0
    [ "$enable" -eq 1 ]
}

enable_bridge_netfilter() {
    [ -w "$BRIDGE_NF_CALL_IPTABLES" ] || return 0

    echo 1 > "$BRIDGE_NF_CALL_IPTABLES" 2>/dev/null || true
}

get_lan_ifname() {
    local ifname

    ifname="$(uci get network.lan.device 2>/dev/null)"
    [ -n "$ifname" ] || ifname="$(uci get network.lan.ifname 2>/dev/null)"
    [ -n "$ifname" ] || ifname="br-lan"

    echo "$ifname"
}

is_bridge_mode() {
    [ "$(uci -q get system.operation_mode.mode 2>/dev/null)" = "bridge" ]
}

allow_bridge_dhcp() {
    is_bridge_mode || return 0

    # DHCP is supplied by the upstream network in transparent bridge mode.
    # These rules must precede the FIDO authorization/drop rules so clients
    # can obtain or renew an address before authenticating.
    iptables -A "$FIDO_CHAIN" -p udp --sport 68 --dport 67 -j ACCEPT
    iptables -A "$FIDO_CHAIN" -p udp --sport 67 --dport 68 -j ACCEPT
}

remove_fido_forward_jumps() {
    local lan_if
    lan_if="$(get_lan_ifname)"

    while iptables -D FORWARD -i "$lan_if" -j "$FIDO_CHAIN" 2>/dev/null; do :; done
    while iptables -D FORWARD -j "$FIDO_CHAIN" 2>/dev/null; do :; done
}

enable_fido_redirect_rules() {
    local lan_if
    lan_if="$(get_lan_ifname)"

    local redirect_port="80"

    iptables -t nat -N "$FIDO_NAT_CHAIN" 2>/dev/null || true
    iptables -t nat -F "$FIDO_NAT_CHAIN"

    while iptables -t nat -D PREROUTING -j "$FIDO_NAT_CHAIN" 2>/dev/null; do :; done
    iptables -t nat -I PREROUTING 1 -j "$FIDO_NAT_CHAIN"

    iptables -t nat -A "$FIDO_NAT_CHAIN" -i "$lan_if" -m set --match-set "$IPSET_NAME" src -j RETURN
    iptables -t nat -A "$FIDO_NAT_CHAIN" -i "$lan_if" -p tcp --dport 80 \
        -j REDIRECT --to-ports "$redirect_port"
}

disable_fido_redirect_rules() {
    while iptables -t nat -D PREROUTING -j "$FIDO_NAT_CHAIN" 2>/dev/null; do :; done
    iptables -t nat -F "$FIDO_NAT_CHAIN" 2>/dev/null
    iptables -t nat -X "$FIDO_NAT_CHAIN" 2>/dev/null
}

setup_authorized_ipset() {
    ipset create "$IPSET_NAME" hash:ip timeout 14400 comment 2>/dev/null || true
}

setup_sfa_server_ipset() {
    ipset create "$SFA_IPSET_NAME" hash:ip,port 2>/dev/null || true
    ipset flush "$SFA_IPSET_NAME" 2>/dev/null || true
}

add_sfa_server_port() {
    local section="$1"
    local ip
    local port
    local proto

    config_get ip "$section" ip
    config_get port "$section" port
    config_get proto "$section" proto tcp

    [ -n "$ip" ] || return 0
    [ -n "$port" ] || return 0

    proto="$(printf '%s' "$proto" | tr '[:upper:]' '[:lower:]')"
    case "$proto" in
        tcp|udp|udplite|sctp|dccp) ;;
        *) proto="tcp" ;;
    esac

    ipset -! add "$SFA_IPSET_NAME" "$ip,$proto:$port" 2>/dev/null || true
}

load_sfa_server_ports() {
    setup_sfa_server_ipset
    config_load sfa
    config_foreach add_sfa_server_port sfa
}

allow_sfa_server_source() {
    local section="$1"
    local ip

    config_get ip "$section" ip
    [ -n "$ip" ] || return 0

    iptables -A "$FIDO_CHAIN" -s "$ip" -j RETURN
}

destroy_authorized_ipset() {
    ipset destroy "$IPSET_NAME" 2>/dev/null
}

destroy_sfa_server_ipset() {
    ipset destroy "$SFA_IPSET_NAME" 2>/dev/null
}

setup_fido_chain() {
    local lan_if
    lan_if="$(get_lan_ifname)"

    iptables -N "$FIDO_CHAIN" 2>/dev/null || true
    iptables -F "$FIDO_CHAIN"

    remove_fido_forward_jumps
    iptables -I FORWARD 1 -i "$lan_if" -j "$FIDO_CHAIN"

    allow_bridge_dhcp
    iptables -A "$FIDO_CHAIN" -m set --match-set "$IPSET_NAME" src -j RETURN
    config_load sfa
    config_foreach allow_sfa_server_source sfa
    iptables -A "$FIDO_CHAIN" -p tcp -m set --match-set "$SFA_IPSET_NAME" dst,dst -j REJECT --reject-with tcp-reset
    iptables -A "$FIDO_CHAIN" -m set --match-set "$SFA_IPSET_NAME" dst,dst -j REJECT
    iptables -A "$FIDO_CHAIN" -p tcp --dport 443 -j REJECT --reject-with tcp-reset
    iptables -A "$FIDO_CHAIN" -j DROP
}

destroy_fido_chain() {
    remove_fido_forward_jumps
    iptables -F "$FIDO_CHAIN" 2>/dev/null
    iptables -X "$FIDO_CHAIN" 2>/dev/null
}

apply_fido_rules() {
    is_fido_mode_enabled || return 0

    enable_bridge_netfilter
    setup_authorized_ipset
    load_sfa_server_ports
    setup_fido_chain
    enable_fido_redirect_rules
}

start_node_app() {
    procd_open_instance

    procd_set_param command /usr/bin/node /etc/bmcfido/app.js
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance
}

start_service() {
    is_fido_mode_enabled || return 0

    apply_fido_rules
    start_node_app
}

stop_service() {
    disable_fido_redirect_rules
    destroy_fido_chain
    destroy_sfa_server_ipset
    destroy_authorized_ipset
}

reload_rules() {
	if is_fido_mode_enabled; then
		apply_fido_rules
	else
		disable_fido_redirect_rules
		destroy_fido_chain
		destroy_sfa_server_ipset
		destroy_authorized_ipset
	fi
}

reload_service() {
    restart
}
