#!/bin/sh

[ "$ACTION" = ifup ] || [ "$ACTION" = ifupdate ] || exit 0
[ "$(uci -q get bmcqos.global.enabled)" = 1 ] || exit 0
wan="$(uci -q get bmcqos.settings.WAN)"
[ "$INTERFACE" = wan ] || [ "$DEVICE" = "$wan" ] || exit 0
logger -t bmcqos "Reapplying QoS after $ACTION on ${DEVICE:-$INTERFACE}"
/etc/init.d/bmcqos restart

