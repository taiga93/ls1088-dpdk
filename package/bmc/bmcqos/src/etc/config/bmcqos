config global 'global'
	option enabled '0'
	option backend 'fw3'

config settings 'settings'
	option WAN 'eth0'
	option DOWNRATE '90000'
	option UPRATE '45000'
	option ROOT_QDISC 'cake'

config firewall 'firewall'
	option hook 'FORWARD'
	option ipv6_enabled '1'

config advanced 'advanced'
	option enabled '0'
	option WASHDSCPUP '0'
	option WASHDSCPDOWN '0'
	option BWMAXRATIO '20'
	option UDPBULKPORT ''
	option TCPBULKPORT ''
	option VIDCONFPORTS ''
	option REALTIME4 ''
	option REALTIME6 ''
	option LOWPRIOLAN4 ''
	option LOWPRIOLAN6 ''
	option MSS ''
	option COMMON_LINK_PRESETS 'raw'
	option OVERHEAD '0'
	option MPU ''
	option LINK_COMPENSATION ''
	option ETHER_VLAN_KEYWORD ''
	# Các tính năng nftables sau không được triển khai trên backend fw3.
	option dynamic_ipset '0'
	option auto_merge_ranges '0'
	option detailed_meter_stats '0'
	option per_device_rate_limit '0'
	option connection_flow_detection '0'

config hfsc 'hfsc'
	option gameqdisc 'pfifo'
	option GAMEUP ''
	option GAMEDOWN ''
	option nongameqdisc 'fq_codel'
	option nongameqdiscoptions 'besteffort ack-filter'
	option MAXDEL '24'
	option PFIFOMIN '5'
	option PACKETSIZE '450'
	option netemdelayms '30'
	option netemjitterms '7'
	option netemdist 'normal'
	option pktlossp 'none'
	option netem_direction 'both'

config cake 'cake'
	option PRIORITY_QUEUE_INGRESS 'diffserv4'
	option PRIORITY_QUEUE_EGRESS 'diffserv4'
	option USE_MQ '0'
	option HOST_ISOLATION '1'
	option NAT_INGRESS '1'
	option NAT_EGRESS '1'
	option ACK_FILTER_EGRESS 'auto'
	option RTT ''
	option AUTORATE_INGRESS '0'
	option EXTRA_PARAMETERS_INGRESS ''
	option EXTRA_PARAMETERS_EGRESS ''

config autorate 'autorate'
	option enabled '0'
	option interval '500'
	option min_ul_rate ''
	option base_ul_rate ''
	option max_ul_rate ''
	option min_dl_rate ''
	option base_dl_rate ''
	option max_dl_rate ''
	option latency_increase_threshold '5'
	option latency_decrease_threshold '10'
	option reflectors '1.1.1.1 8.8.8.8 9.9.9.9'
	option refractory_increase '3'
	option refractory_decrease '1'
	option adjust_up_factor '102'
	option adjust_down_factor '85'
	option flash_history '0'
	option log_changes '0'

