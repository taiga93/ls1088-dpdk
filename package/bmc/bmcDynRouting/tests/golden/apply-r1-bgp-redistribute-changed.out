{"status":0,"message":"routing plan ready","action":"start","frr_restart":["ospfd","bgpd"],"frr_conf":"frr version 10
frr defaults traditional
hostname bmcDynRouting
service integrated-vtysh-config
!
router-id 1.1.1.1
!
! bmcDynRouting: ospfd
router ospf
 redistribute bgp route-map BMC-BGP-TO-OSPF
!
interface br-lan
 ip ospf area 0.0.0.0
 ip ospf passive
 ip ospf network broadcast
!
interface eth6
 ip ospf area 0.0.0.0
 ip ospf network point-to-point
!
interface eth7
 ip ospf area 0.0.0.0
 ip ospf network point-to-point
!
route-map BMC-BGP-TO-OSPF permit 10
 set tag 64512
exit
!
! bmcDynRouting: bgpd
router bgp 65001
 no bgp default ipv4-unicast
 neighbor 203.0.113.1 remote-as 64500
 neighbor 203.0.113.1 description ISP-A uplink
 neighbor 203.0.113.1 password <hidden>
 !
 address-family ipv4 unicast
  network 192.168.1.0/24
  network 10.0.12.0/30
  redistribute connected route-map BMC-BGP-REDISTRIBUTE
  neighbor 203.0.113.1 activate
  neighbor 203.0.113.1 route-map BMC-BGP-IN-ALL in
  neighbor 203.0.113.1 route-map BMC-BGP-OUT out
  neighbor 203.0.113.1 maximum-prefix 1000
 exit-address-family
exit
!
bgp as-path access-list BMC-BGP-LOCAL seq 5 permit ^$
!
ip prefix-list BMC-BGP-DEFAULT seq 5 permit 0.0.0.0/0
!
route-map BMC-BGP-OUT permit 10
 match as-path BMC-BGP-LOCAL
exit
!
route-map BMC-BGP-IN-ALL permit 10
exit
!
route-map BMC-BGP-IN-DEFAULT permit 10
 match ip address prefix-list BMC-BGP-DEFAULT
exit
!
route-map BMC-BGP-REDISTRIBUTE deny 10
 match tag 64512
exit
!
route-map BMC-BGP-REDISTRIBUTE deny 20
 match ip address prefix-list BMC-BGP-DEFAULT
exit
!
route-map BMC-BGP-REDISTRIBUTE permit 30
exit
!
! bmcDynRouting: bgpd
router bgp 65001
 bgp log-neighbor-changes
!","daemons":"zebra=yes
ospfd=yes
ripd=no
bgpd=yes
ospf6d=no
watchfrr=yes","firewall_rules":"iptables -I INPUT -i br-lan -p 89 -m comment --comment bmcDynRouting -j ACCEPT
iptables -I INPUT -i eth6 -p 89 -m comment --comment bmcDynRouting -j ACCEPT
iptables -I INPUT -i eth7 -p 89 -m comment --comment bmcDynRouting -j ACCEPT
iptables -I INPUT -s 203.0.113.1 -p tcp --dport 179 -m comment --comment bmcDynRouting -j ACCEPT"}
exit=0
