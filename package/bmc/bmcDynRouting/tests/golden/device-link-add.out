{"status":0,"message":"Link định tuyến created","uci_batch":"del_list network.cfg030f15.ports='eth6'
set network.link_eth6=interface
set network.link_eth6.device='eth6'
set network.link_eth6.proto='static'
set network.link_eth6.ipaddr='10.0.12.1'
set network.link_eth6.netmask='255.255.255.252'
set network.link_eth6.bmc_role='dynrouting_link'
set dhcp.link_eth6=dhcp
set dhcp.link_eth6.interface='link_eth6'
set dhcp.link_eth6.ignore='1'
set firewall.dynrouting=zone
set firewall.dynrouting.name='dynrouting'
set firewall.dynrouting.input='REJECT'
set firewall.dynrouting.output='ACCEPT'
set firewall.dynrouting.forward='ACCEPT'
set firewall.dynrouting_lan_in=forwarding
set firewall.dynrouting_lan_in.src='lan'
set firewall.dynrouting_lan_in.dest='dynrouting'
set firewall.dynrouting_lan_out=forwarding
set firewall.dynrouting_lan_out.src='dynrouting'
set firewall.dynrouting_lan_out.dest='lan'
set firewall.dynrouting_icmp=rule
set firewall.dynrouting_icmp.name='Allow-DynRouting-ICMP'
set firewall.dynrouting_icmp.src='dynrouting'
set firewall.dynrouting_icmp.proto='icmp'
set firewall.dynrouting_icmp.target='ACCEPT'
add_list firewall.dynrouting.network='link_eth6'"}
exit=0
