{"status":0,"message":"routing plan ready","action":"start","frr_restart":["zebra","ospfd","bgpd"],"frr_conf":"frr version 10
frr defaults traditional
hostname bmcDynRouting
service integrated-vtysh-config
!
router-id 2.2.2.2
!
! bmcDynRouting: ospfd
router ospf
!
interface br-lan
 ip ospf area 0.0.0.0
 ip ospf passive
 ip ospf network broadcast
!
interface eth6
 ip ospf area 0.0.0.0
 ip ospf network point-to-point
!
interface eth7
 ip ospf area 0.0.0.0
 ip ospf network point-to-point
!
! bmcDynRouting: bgpd
router bgp 65001
 no bgp default ipv4-unicast
 neighbor 198.51.100.1 remote-as 64501
 neighbor 198.51.100.1 description ISP-B
 neighbor 198.51.100.1 timers 10 30
 neighbor 198.51.100.2 remote-as 64502
 neighbor 198.51.100.2 shutdown
 neighbor 192.0.2.9 remote-as 64503
 neighbor 192.0.2.9 timers 60 90
 !
 address-family ipv4 unicast
  network 192.168.2.0/24
  neighbor 198.51.100.1 activate
  neighbor 198.51.100.1 route-map BMC-BGP-IN-DEFAULT in
  neighbor 198.51.100.1 route-map BMC-BGP-OUT out
  neighbor 198.51.100.1 maximum-prefix 10
  neighbor 198.51.100.2 activate
  neighbor 198.51.100.2 route-map BMC-BGP-IN-ALL in
  neighbor 198.51.100.2 route-map BMC-BGP-OUT out
  neighbor 198.51.100.2 maximum-prefix 1000
  neighbor 192.0.2.9 activate
  neighbor 192.0.2.9 route-map BMC-BGP-IN-ALL in
  neighbor 192.0.2.9 route-map BMC-BGP-OUT out
  neighbor 192.0.2.9 maximum-prefix 1000
 exit-address-family
exit
!
bgp as-path access-list BMC-BGP-LOCAL seq 5 permit ^$
!
ip prefix-list BMC-BGP-DEFAULT seq 5 permit 0.0.0.0/0
!
route-map BMC-BGP-OUT permit 10
 match as-path BMC-BGP-LOCAL
exit
!
route-map BMC-BGP-IN-ALL permit 10
exit
!
route-map BMC-BGP-IN-DEFAULT permit 10
 match ip address prefix-list BMC-BGP-DEFAULT
exit
!","daemons":"zebra=yes
ospfd=yes
ripd=no
bgpd=yes
ospf6d=no
watchfrr=yes","firewall_rules":"iptables -I INPUT -i br-lan -p 89 -m comment --comment bmcDynRouting -j ACCEPT
iptables -I INPUT -i eth6 -p 89 -m comment --comment bmcDynRouting -j ACCEPT
iptables -I INPUT -i eth7 -p 89 -m comment --comment bmcDynRouting -j ACCEPT
iptables -I INPUT -s 198.51.100.1 -p tcp --dport 179 -m comment --comment bmcDynRouting -j ACCEPT
iptables -I INPUT -s 192.0.2.9 -p tcp --dport 179 -m comment --comment bmcDynRouting -j ACCEPT"}
exit=0
