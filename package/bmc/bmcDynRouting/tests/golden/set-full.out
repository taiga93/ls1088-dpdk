{"status":0,"message":"OSPF configuration saved","uci_batch":"delete bmcDynRouting.oi_lan
delete bmcDynRouting.oi_link_eth6
delete bmcDynRouting.oi_link_eth7
set bmcDynRouting.oi_lan=ospf_interface
set bmcDynRouting.oi_lan.interface='lan'
set bmcDynRouting.oi_lan.area='0'
set bmcDynRouting.oi_lan.passive='1'
set bmcDynRouting.oi_link_eth6=ospf_interface
set bmcDynRouting.oi_link_eth6.interface='link_eth6'
set bmcDynRouting.oi_link_eth6.area='0'
set bmcDynRouting.oi_link_eth6.passive='0'
set bmcDynRouting.oi_link_eth6.cost='10'
set bmcDynRouting.oi_link_eth6.hello_interval='2'
set bmcDynRouting.oi_link_eth6.dead_interval='8'
set bmcDynRouting.oi_link_eth6.network_type='broadcast'
add_list bmcDynRouting.ospf.advanced_line='router ospf'
add_list bmcDynRouting.ospf.advanced_line=' ip ospf message-digest-key 1 md5 it'\\''s\\secret'
set bmcDynRouting.oi_guest=ospf_interface
set bmcDynRouting.oi_guest.interface='guest'
set bmcDynRouting.oi_guest.area='1'
set bmcDynRouting.oi_guest.passive='1'
set bmcDynRouting.ospf.enabled='1'
set bmcDynRouting.ospf.redistribute_static='1'
set bmcDynRouting.ospf.redistribute_connected='0'
set bmcDynRouting.ospf.redistribute_rip='0'
set bmcDynRouting.ospf.redistribute_bgp='0'","warnings":[]}
exit=0
