bmcDynRouting.global=global
bmcDynRouting.ospf=ospf
bmcDynRouting.ospf.enabled='1'
bmcDynRouting.ospf.redistribute_static='0'
bmcDynRouting.ospf.redistribute_connected='0'
bmcDynRouting.oi_lan=ospf_interface
bmcDynRouting.oi_lan.interface='lan'
bmcDynRouting.oi_lan.passive='1'
bmcDynRouting.oi_lan.area='0'
bmcDynRouting.oi_link_eth6=ospf_interface
bmcDynRouting.oi_link_eth6.interface='link_eth6'
bmcDynRouting.oi_link_eth6.area='0'
bmcDynRouting.oi_link_eth6.passive='0'
bmcDynRouting.oi_link_eth7=ospf_interface
bmcDynRouting.oi_link_eth7.interface='link_eth7'
bmcDynRouting.oi_link_eth7.area='0'
bmcDynRouting.oi_link_eth7.passive='0'
network.loopback=interface
network.loopback.device='lo'
network.loopback.proto='static'
network.loopback.ipaddr='127.0.0.1'
network.loopback.netmask='255.0.0.0'
network.globals=globals
network.globals.ula_prefix='fdea:8b07:5566::/48'
network.cfg030f15=device
network.cfg030f15.name='br-lan'
network.cfg030f15.type='bridge'
network.cfg030f15.ports='eth1' 'eth2' 'eth3' 'eth4' 'eth1.100'
network.lan=interface
network.lan.device='br-lan'
network.lan.proto='static'
network.lan.ipaddr='192.168.1.1'
network.lan.netmask='255.255.255.0'
network.lan.ip6assign='60'
network.wan=interface
network.wan.device='eth0'
network.wan.proto='dhcp'
network.wan6=interface
network.wan6.device='eth0'
network.wan6.proto='dhcpv6'
network.cfg050f15=device
network.cfg050f15.name='br-guest'
network.cfg050f15.type='bridge'
network.cfg050f15.ports='eth5'
network.guest=interface
network.guest.device='br-guest'
network.guest.proto='static'
network.guest.ipaddr='192.168.6.1/24'
network.link_eth6=interface
network.link_eth6.device='eth6'
network.link_eth6.proto='static'
network.link_eth6.ipaddr='10.0.12.1'
network.link_eth6.netmask='255.255.255.252'
network.link_eth6.bmc_role='dynrouting_link'
network.link_eth7=interface
network.link_eth7.device='eth7'
network.link_eth7.proto='static'
network.link_eth7.ipaddr='10.0.13.1'
network.link_eth7.netmask='255.255.255.252'
network.link_eth7.bmc_role='dynrouting_link'
firewall.cfg01e63d=defaults
firewall.cfg01e63d.input='ACCEPT'
firewall.cfg01e63d.output='ACCEPT'
firewall.cfg01e63d.forward='REJECT'
firewall.cfg02dc81=zone
firewall.cfg02dc81.name='lan'
firewall.cfg02dc81.network='lan' 'guest'
firewall.cfg02dc81.input='ACCEPT'
firewall.cfg02dc81.output='ACCEPT'
firewall.cfg02dc81.forward='ACCEPT'
firewall.cfg03dc81=zone
firewall.cfg03dc81.name='wan'
firewall.cfg03dc81.network='wan' 'wan6'
firewall.cfg03dc81.input='REJECT'
firewall.cfg03dc81.output='ACCEPT'
firewall.cfg03dc81.forward='REJECT'
firewall.cfg03dc81.masq='1'
firewall.cfg03dc81.mtu_fix='1'
firewall.cfg04ad58=forwarding
firewall.cfg04ad58.src='lan'
firewall.cfg04ad58.dest='wan'
firewall.cfg0592bd=rule
firewall.cfg0592bd.name='Allow-DHCP-Renew'
firewall.cfg0592bd.src='wan'
firewall.cfg0592bd.proto='udp'
firewall.cfg0592bd.dest_port='68'
firewall.cfg0592bd.target='ACCEPT'
firewall.dynrouting=zone
firewall.dynrouting.name='dynrouting'
firewall.dynrouting.input='REJECT'
firewall.dynrouting.output='ACCEPT'
firewall.dynrouting.forward='ACCEPT'
firewall.dynrouting.network='link_eth6' 'link_eth7'
firewall.dynrouting_lan_in=forwarding
firewall.dynrouting_lan_in.src='lan'
firewall.dynrouting_lan_in.dest='dynrouting'
firewall.dynrouting_lan_out=forwarding
firewall.dynrouting_lan_out.src='dynrouting'
firewall.dynrouting_lan_out.dest='lan'
firewall.dynrouting_icmp=rule
firewall.dynrouting_icmp.name='Allow-DynRouting-ICMP'
firewall.dynrouting_icmp.src='dynrouting'
firewall.dynrouting_icmp.proto='icmp'
firewall.dynrouting_icmp.target='ACCEPT'
firewall.bmcDynRouting=include
firewall.bmcDynRouting.type='script'
firewall.bmcDynRouting.path='/usr/share/bmcDynRouting/firewall.include'
firewall.bmcDynRouting.reload='1'
dhcp.cfg01411c=dnsmasq
dhcp.cfg01411c.domainneeded='1'
dhcp.cfg01411c.local='/lan/'
dhcp.lan=dhcp
dhcp.lan.interface='lan'
dhcp.lan.start='100'
dhcp.lan.limit='150'
dhcp.lan.leasetime='12h'
dhcp.wan=dhcp
dhcp.wan.interface='wan'
dhcp.wan.ignore='1'
dhcp.cfg06fe63=dhcp
dhcp.cfg06fe63.interface='guest'
dhcp.cfg06fe63.start='100'
dhcp.cfg06fe63.limit='50'
dhcp.link_eth6=dhcp
dhcp.link_eth6.interface='link_eth6'
dhcp.link_eth6.ignore='1'
dhcp.link_eth7=dhcp
dhcp.link_eth7.interface='link_eth7'
dhcp.link_eth7.ignore='1'
