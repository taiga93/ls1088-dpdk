bmcDynRouting.ospf=ospf
bmcDynRouting.ospf.enabled='0'
bmcDynRouting.ospf.redistribute_static='0'
bmcDynRouting.ospf.redistribute_connected='0'
dhcp.cfg01411c=dnsmasq
dhcp.cfg01411c.domainneeded='1'
dhcp.cfg01411c.boguspriv='1'
dhcp.cfg01411c.filterwin2k='0'
dhcp.cfg01411c.localise_queries='1'
dhcp.cfg01411c.rebind_protection='1'
dhcp.cfg01411c.rebind_localhost='1'
dhcp.cfg01411c.local='/lan/'
dhcp.cfg01411c.domain='lan'
dhcp.cfg01411c.expandhosts='1'
dhcp.cfg01411c.nonegcache='0'
dhcp.cfg01411c.cachesize='0'
dhcp.cfg01411c.authoritative='1'
dhcp.cfg01411c.readethers='1'
dhcp.cfg01411c.leasefile='/tmp/dhcp.leases'
dhcp.cfg01411c.resolvfile='/tmp/resolv.conf.d/resolv.conf.auto'
dhcp.cfg01411c.nonwildcard='1'
dhcp.cfg01411c.localservice='1'
dhcp.cfg01411c.ednspacket_max='1232'
dhcp.cfg01411c.filter_aaaa='0'
dhcp.cfg01411c.filter_a='0'
dhcp.cfg01411c.port='54'
dhcp.cfg01411c.noresolv='1'
dhcp.lan=dhcp
dhcp.lan.interface='lan'
dhcp.lan.start='100'
dhcp.lan.limit='150'
dhcp.lan.leasetime='12h'
dhcp.lan.dhcpv4='server'
dhcp.lan.dhcpv6='server'
dhcp.lan.ra='server'
dhcp.lan.ra_slaac='1'
dhcp.lan.ra_flags='managed-config' 'other-config'
dhcp.lan.dhcp_option='3,192.168.5.1' '6,192.168.5.1' '15,lan'
dhcp.lan.dns='fd29:d5d5:98d6:4::1'
dhcp.wan=dhcp
dhcp.wan.interface='wan'
dhcp.wan.ignore='1'
dhcp.odhcpd=odhcpd
dhcp.odhcpd.maindhcp='0'
dhcp.odhcpd.leasefile='/tmp/hosts/odhcpd'
dhcp.odhcpd.leasetrigger='/usr/sbin/odhcpd-update'
dhcp.odhcpd.loglevel='4'
firewall.cfg01e63d=defaults
firewall.cfg01e63d.syn_flood='1'
firewall.cfg01e63d.input='REJECT'
firewall.cfg01e63d.output='ACCEPT'
firewall.cfg01e63d.forward='REJECT'
firewall.cfg02dc81=zone
firewall.cfg02dc81.name='lan'
firewall.cfg02dc81.network='lan'
firewall.cfg02dc81.input='ACCEPT'
firewall.cfg02dc81.output='ACCEPT'
firewall.cfg02dc81.forward='ACCEPT'
firewall.cfg03dc81=zone
firewall.cfg03dc81.name='wan'
firewall.cfg03dc81.network='wan' 'wan6'
firewall.cfg03dc81.input='REJECT'
firewall.cfg03dc81.output='ACCEPT'
firewall.cfg03dc81.forward='REJECT'
firewall.cfg03dc81.masq='1'
firewall.cfg03dc81.mtu_fix='1'
firewall.cfg04ad58=forwarding
firewall.cfg04ad58.src='lan'
firewall.cfg04ad58.dest='wan'
firewall.cfg0592bd=rule
firewall.cfg0592bd.name='Allow-DHCP-Renew'
firewall.cfg0592bd.src='wan'
firewall.cfg0592bd.proto='udp'
firewall.cfg0592bd.dest_port='68'
firewall.cfg0592bd.target='ACCEPT'
firewall.cfg0592bd.family='ipv4'
firewall.cfg0692bd=rule
firewall.cfg0692bd.name='Allow-Ping'
firewall.cfg0692bd.src='wan'
firewall.cfg0692bd.proto='icmp'
firewall.cfg0692bd.icmp_type='echo-request'
firewall.cfg0692bd.family='ipv4'
firewall.cfg0692bd.target='ACCEPT'
firewall.cfg0792bd=rule
firewall.cfg0792bd.name='Allow-IGMP'
firewall.cfg0792bd.src='wan'
firewall.cfg0792bd.proto='igmp'
firewall.cfg0792bd.family='ipv4'
firewall.cfg0792bd.target='ACCEPT'
firewall.cfg0892bd=rule
firewall.cfg0892bd.name='Allow-DHCPv6'
firewall.cfg0892bd.src='wan'
firewall.cfg0892bd.proto='udp'
firewall.cfg0892bd.dest_port='546'
firewall.cfg0892bd.family='ipv6'
firewall.cfg0892bd.target='ACCEPT'
firewall.cfg0992bd=rule
firewall.cfg0992bd.name='Allow-MLD'
firewall.cfg0992bd.src='wan'
firewall.cfg0992bd.proto='icmp'
firewall.cfg0992bd.src_ip='fe80::/10'
firewall.cfg0992bd.icmp_type='130/0' '131/0' '132/0' '143/0'
firewall.cfg0992bd.family='ipv6'
firewall.cfg0992bd.target='ACCEPT'
firewall.cfg0a92bd=rule
firewall.cfg0a92bd.name='Allow-ICMPv6-Input'
firewall.cfg0a92bd.src='wan'
firewall.cfg0a92bd.proto='icmp'
firewall.cfg0a92bd.icmp_type='echo-request' 'echo-reply' 'destination-unreachable' 'packet-too-big' 'time-exceeded' 'bad-header' 'unknown-header-type'
 'router-solicitation' 'neighbour-solicitation' 'router-advertisement' 'neighbour-advertisement'
firewall.cfg0a92bd.limit='1000/sec'
firewall.cfg0a92bd.family='ipv6'
firewall.cfg0a92bd.target='ACCEPT'
firewall.cfg0b92bd=rule
firewall.cfg0b92bd.name='Allow-ICMPv6-Forward'
firewall.cfg0b92bd.src='wan'
firewall.cfg0b92bd.dest='*'
firewall.cfg0b92bd.proto='icmp'
firewall.cfg0b92bd.icmp_type='echo-request' 'echo-reply' 'destination-unreachable' 'packet-too-big' 'time-exceeded' 'bad-header' 'unknown-header-type'
firewall.cfg0b92bd.limit='1000/sec'
firewall.cfg0b92bd.family='ipv6'
firewall.cfg0b92bd.target='ACCEPT'
firewall.cfg0c92bd=rule
firewall.cfg0c92bd.name='Allow-IPSec-ESP'
firewall.cfg0c92bd.src='wan'
firewall.cfg0c92bd.dest='lan'
firewall.cfg0c92bd.proto='esp'
firewall.cfg0c92bd.target='ACCEPT'
firewall.cfg0d92bd=rule
firewall.cfg0d92bd.name='Allow-ISAKMP'
firewall.cfg0d92bd.src='wan'
firewall.cfg0d92bd.dest='lan'
firewall.cfg0d92bd.dest_port='500'
firewall.cfg0d92bd.proto='udp'
firewall.cfg0d92bd.target='ACCEPT'
firewall.cfg0e92bd=rule
firewall.cfg0e92bd.name='Support-UDP-Traceroute'
firewall.cfg0e92bd.src='wan'
firewall.cfg0e92bd.dest_port='33434:33689'
firewall.cfg0e92bd.proto='udp'
firewall.cfg0e92bd.family='ipv4'
firewall.cfg0e92bd.target='REJECT'
firewall.cfg0e92bd.enabled='false'
firewall.cfg0faf89=include
firewall.cfg0faf89.path='/etc/firewall.user'
firewall.bmcDynRouting=include
firewall.bmcDynRouting.type='script'
firewall.bmcDynRouting.path='/usr/share/bmcDynRouting/firewall.include'
firewall.bmcDynRouting.reload='1'
network.loopback=interface
network.loopback.device='lo'
network.loopback.proto='static'
network.loopback.ipaddr='127.0.0.1'
network.loopback.netmask='255.0.0.0'
network.globals=globals
network.globals.ula_prefix='fdea:8b07:5566::/48'
