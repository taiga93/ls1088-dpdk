// client/src/helpers/twosky.ts

export interface TwoskyConfig {
  base_locale: string;
  languages: string[];
}

export const twosky: TwoskyConfig[] = [
  {
    base_locale: 'en',
    languages: ['en', 'vi', 'fr'],
  },
];

export const LANGUAGES: Record<string, string> = twosky[0].languages.reduce(
  (acc, lang) => {
    acc[lang] = lang;
    return acc;
  },
  {} as Record<string, string>
);

export const BASE_LOCALE: string = twosky[0].base_locale;
