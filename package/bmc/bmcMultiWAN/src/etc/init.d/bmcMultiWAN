#!/bin/sh /etc/rc.common

# After the firewall (S19) and before the network (S20network), like mwan3's own init script: mwan3 then
# sets up each WAN from its ifup hotplug event.
START=20
STOP=10

start() {
	/usr/sbin/bmcmultiwan apply >/dev/null
}

stop() {
	/etc/init.d/mwan3 stop >/dev/null 2>&1 || true
}

reload() {
	start
}
