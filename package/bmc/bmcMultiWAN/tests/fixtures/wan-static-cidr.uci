bmcMultiWAN.global=global
bmcMultiWAN.global.enabled='1'
mwan3.globals=globals
mwan3.globals.mmx_mask='0x3F00'
mwan3.globals.bmc_managed='1'
mwan3.wan=interface
mwan3.wan.enabled='1'
mwan3.wan.family='ipv4'
mwan3.wan.track_ip='1.1.1.1' '8.8.8.8'
mwan3.wan.reliability='1'
mwan3.wan.interval='5'
mwan3.wan.timeout='2'
mwan3.wan.down='3'
mwan3.wan.up='5'
mwan3.wan.initial_state='online'
mwan3.wan_m1=member
mwan3.wan_m1.interface='wan'
mwan3.wan_m1.metric='1'
mwan3.wan_m1.weight='1'
mwan3.default_policy=policy
mwan3.default_policy.use_member='wan_m1'
mwan3.default_policy.last_resort='default'
mwan3.default_rule=rule
mwan3.default_rule.family='ipv4'
mwan3.default_rule.dest_ip='0.0.0.0/0'
mwan3.default_rule.use_policy='default_policy'
network.loopback=interface
network.loopback.device='lo'
network.loopback.proto='static'
network.loopback.ipaddr='127.0.0.1'
network.loopback.netmask='255.0.0.0'
network.globals=globals
network.globals.ula_prefix='fdea:8b07:5566::/48'
network.cfg030f15=device
network.cfg030f15.name='br-lan'
network.cfg030f15.type='bridge'
network.cfg030f15.ports='eth1' 'eth2' 'eth3' 'eth4'
network.lan=interface
network.lan.device='br-lan'
network.lan.proto='static'
network.lan.ipaddr='192.168.1.1'
network.lan.netmask='255.255.255.0'
network.lan.ip6assign='60'
network.wan=interface
network.wan.device='eth0'
network.wan.proto='static'
network.wan.ipaddr='203.0.113.2/24'
network.wan.gateway='203.0.113.1'
network.wan6=interface
network.wan6.device='eth0'
network.wan6.proto='dhcpv6'
network.cfg050f15=device
network.cfg050f15.name='br-guest'
network.cfg050f15.type='bridge'
network.cfg050f15.ports='eth5'
network.guest=interface
network.guest.device='br-guest'
network.guest.proto='static'
network.guest.ipaddr='192.168.6.1/24'
network.link_eth7=interface
network.link_eth7.device='eth7'
network.link_eth7.proto='static'
network.link_eth7.ipaddr='10.0.13.1'
network.link_eth7.netmask='255.255.255.252'
network.link_eth7.bmc_role='dynrouting_link'
firewall.cfg01e63d=defaults
firewall.cfg01e63d.input='ACCEPT'
firewall.cfg01e63d.output='ACCEPT'
firewall.cfg01e63d.forward='REJECT'
firewall.cfg02dc81=zone
firewall.cfg02dc81.name='lan'
firewall.cfg02dc81.network='lan' 'guest'
firewall.cfg02dc81.input='ACCEPT'
firewall.cfg02dc81.output='ACCEPT'
firewall.cfg02dc81.forward='ACCEPT'
firewall.cfg03dc81=zone
firewall.cfg03dc81.name='wan'
firewall.cfg03dc81.network='wan' 'wan6'
firewall.cfg03dc81.input='REJECT'
firewall.cfg03dc81.output='ACCEPT'
firewall.cfg03dc81.forward='REJECT'
firewall.cfg03dc81.masq='1'
firewall.cfg03dc81.mtu_fix='1'
firewall.cfg04ad58=forwarding
firewall.cfg04ad58.src='lan'
firewall.cfg04ad58.dest='wan'
firewall.dynrouting=zone
firewall.dynrouting.name='dynrouting'
firewall.dynrouting.input='REJECT'
firewall.dynrouting.output='ACCEPT'
firewall.dynrouting.forward='ACCEPT'
firewall.dynrouting.network='link_eth7'
bmcHA.cluster=cluster
bmcHA.cluster.heartbeat_port='eth6'
bmcHA.cluster.heartbeat_port_backup='eth8'
