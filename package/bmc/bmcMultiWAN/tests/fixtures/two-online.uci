bmcMultiWAN.global=global
bmcMultiWAN.global.enabled='1'
mwan3.globals=globals
mwan3.globals.mmx_mask='0x3F00'
mwan3.globals.bmc_managed='1'
mwan3.wan=interface
mwan3.wan.enabled='1'
mwan3.wan.family='ipv4'
mwan3.wan.track_ip='1.1.1.1' '8.8.8.8'
mwan3.wan.reliability='1'
mwan3.wan.interval='5'
mwan3.wan.timeout='2'
mwan3.wan.down='3'
mwan3.wan.up='5'
mwan3.wan.initial_state='online'
mwan3.wan_m1=member
mwan3.wan_m1.interface='wan'
mwan3.wan_m1.metric='1'
mwan3.wan_m1.weight='1'
mwan3.default_policy=policy
mwan3.default_policy.use_member='wan_m1' 'wan2_m2'
mwan3.default_policy.last_resort='default'
mwan3.default_rule=rule
mwan3.default_rule.family='ipv4'
mwan3.default_rule.dest_ip='0.0.0.0/0'
mwan3.default_rule.use_policy='default_policy'
mwan3.wan2=interface
mwan3.wan2.enabled='1'
mwan3.wan2.family='ipv4'
mwan3.wan2.track_ip='1.1.1.1' '8.8.8.8'
mwan3.wan2.reliability='1'
mwan3.wan2.interval='5'
mwan3.wan2.timeout='2'
mwan3.wan2.down='3'
mwan3.wan2.up='5'
mwan3.wan2.initial_state='online'
mwan3.wan2_m2=member
mwan3.wan2_m2.interface='wan2'
mwan3.wan2_m2.metric='2'
mwan3.wan2_m2.weight='1'
network.wan=interface
network.wan.device='eth0'
network.wan.proto='dhcp'
network.wan2=interface
network.wan2.device='eth1'
network.wan2.proto='dhcp'
network.wan2.metric='10'
network.wan2.bmc_role='multiwan'
