delete mwan3.wan6_m2_w3
delete mwan3.wanb6_m1_w2
delete mwan3.wanb6_m1_w3
delete mwan3.wanb6_m2_w2
delete mwan3.wan_only
delete mwan3.wanb_only
delete mwan3.balanced
delete mwan3.wan_wanb
delete mwan3.wanb_wan
delete mwan3.https
delete mwan3.default_rule_v4
delete mwan3.default_rule_v6
set mwan3.globals=globals
set mwan3.globals.mmx_mask='0x3F00'
set mwan3.globals.bmc_managed='1'
set mwan3.wan=interface
set mwan3.wan.enabled='1'
set mwan3.wan.family='ipv4'
add_list mwan3.wan.track_ip='1.1.1.1'
add_list mwan3.wan.track_ip='8.8.8.8'
set mwan3.wan.reliability='1'
set mwan3.wan.interval='5'
set mwan3.wan.timeout='2'
set mwan3.wan.down='3'
set mwan3.wan.up='5'
set mwan3.wan.initial_state='online'
set mwan3.wan_m1=member
set mwan3.wan_m1.interface='wan'
set mwan3.wan_m1.metric='1'
set mwan3.wan_m1.weight='1'
set mwan3.default_policy=policy
add_list mwan3.default_policy.use_member='wan_m1'
set mwan3.default_policy.last_resort='default'
set mwan3.default_rule=rule
set mwan3.default_rule.family='ipv4'
set mwan3.default_rule.dest_ip='0.0.0.0/0'
set mwan3.default_rule.use_policy='default_policy'"}
exit=0
