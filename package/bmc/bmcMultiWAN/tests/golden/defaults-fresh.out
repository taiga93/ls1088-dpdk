{"status":0,"message":"Multi-WAN default configuration written","uci_batch":"delete mwan3.globals
delete mwan3.wan
delete mwan3.wan6
delete mwan3.wanb
delete mwan3.wanb6
delete mwan3.wan_m1_w3
delete mwan3.wan_m2_w3
delete mwan3.wanb_m1_w2
delete mwan3.wanb_m1_w3
delete mwan3.wanb_m2_w2
