{"status":0,"message":"WAN isp_b added","uci_batch":"del_list network.cfg030f15.ports='eth2'
set network.isp_b=interface
set network.isp_b.device='eth2'
set network.isp_b.proto='pppoe'
set network.isp_b.username='b'\\''user'
set network.isp_b.password='<hidden>'
set network.isp_b.ipv6='0'
set network.isp_b.metric='10'
set network.isp_b.bmc_role='multiwan'
set network.isp_b.bmc_from_lan='1'
add_list firewall.cfg03dc81.network='isp_b'
set mwan3.isp_b=interface
set mwan3.isp_b.enabled='1'
set mwan3.isp_b.family='ipv4'
add_list mwan3.isp_b.track_ip='1.1.1.1'
add_list mwan3.isp_b.track_ip='8.8.8.8'
set mwan3.isp_b.reliability='1'
set mwan3.isp_b.interval='5'
set mwan3.isp_b.timeout='2'
set mwan3.isp_b.down='3'
set mwan3.isp_b.up='5'
set mwan3.isp_b.initial_state='online'
set mwan3.isp_b_m2=member
set mwan3.isp_b_m2.interface='isp_b'
set mwan3.isp_b_m2.metric='2'
set mwan3.isp_b_m2.weight='1'
add_list mwan3.default_policy.use_member='isp_b_m2'","commands":["/etc/init.d/network reload","/etc/init.d/firewall reload"]}
