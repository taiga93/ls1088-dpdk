#!/bin/sh /etc/rc.common

START=97

SCRIPT="/etc/bmcweb/backend/scripts/firewall/dhcpguard.sh"
CHAIN="DHCPGUARD"

# The ebtables rules of DHCPGuard are saved nowhere: the script of the web UI
# writes them from the configuration, here at boot as it does after a change.
start() {
    [ "$(uci -q get dhcpguard.main.enabled)" = 1 ] || return 0
    bash "$SCRIPT" apply >/dev/null 2>&1 || {
        echo "DHCPGuard: the rules could not be written"
        logger -t dhcpguard "apply rules failed on start"
        return 1
    }
}

# Takes the chain of DHCPGuard away and nothing else: the configuration
# stays, and so do the ebtables rules of other features.
stop() {
    while ebtables --concurrent -D FORWARD -j "$CHAIN" 2>/dev/null; do :; done
    ebtables --concurrent -F "$CHAIN" 2>/dev/null
    ebtables --concurrent -X "$CHAIN" 2>/dev/null
    return 0
}
